# .env dosyasının tarayıcıdan indirilmesini engeller
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# İnsanların tarayıcıdan klasör içindeki dosyaları liste halinde görmesini engeller
Options -Indexes

DirectoryIndex index.php index.html

# Tek bir HTTPS adresini kanonik sürüm olarak kullanır.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.oskaycati\.com$ [NC]
RewriteRule ^ https://www.oskaycati.com%{REQUEST_URI} [R=301,L]
